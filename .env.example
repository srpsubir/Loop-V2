# MAV-217: Analytics + crash reporting
# Add these as GitHub Actions secrets and inject them in CI.
# Neither is required locally — analytics will be silently disabled if missing.
SENTRY_DSN=https://your-key@sentry.io/your-project-id
POSTHOG_KEY=phc_your_posthog_key

# MAV-216: Google Sign-In
# Create a Desktop app OAuth client at console.cloud.google.com
# Authorized redirect URI: http://127.0.0.1 (any port — loopback is whitelisted by Google for Desktop apps)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
